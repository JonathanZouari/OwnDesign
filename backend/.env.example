# Copy to backend/.env (never commit .env).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (or legacy anon) key: safe for browsers, RLS applies.
SUPABASE_PUBLISHABLE_KEY=
# Secret (or legacy service_role) key: server only, bypasses RLS.
SUPABASE_SECRET_KEY=
# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5500
# AI advisor, served by Groq's free tier. Server only. It answers "not available" until both are set.
GROQ_API_KEY=
# A model ID from https://console.groq.com/docs/models, for example llama-3.3-70b-versatile. There is no default.
GROQ_MODEL=
