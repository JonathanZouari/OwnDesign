# Copy to backend/.env (never commit .env).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (or legacy anon) key: safe for browsers, RLS applies.
SUPABASE_PUBLISHABLE_KEY=
# Secret (or legacy service_role) key: server only, bypasses RLS.
SUPABASE_SECRET_KEY=
# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5500
# Optional: enables the AI consultant (without it the endpoint answers 503).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional: emails invite links to clients through Resend (resend.com). Without all three, the designer copies the link.
RESEND_API_KEY=
EMAIL_FROM=Atelier <invites@your-domain.com>
# Public frontend address used in emailed links, e.g. http://localhost:5500/frontend
APP_URL=
# Dev and test environments only: every invite email goes to this address instead of the client, with the
# intended address in the subject. Resend's test inbox: delivered@resend.dev. Leave empty in production.
EMAIL_REDIRECT_TO=
